# Copy to .env.local and fill in. Never commit .env.local.
# In production, set the same variables in Vercel → Settings → Environment Variables.

# --- Sanity (CMS + video storage) ----------------------------------------
# Public values, safe in the browser. From sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Shared secret between Sanity's webhook and /api/revalidate, so publishing
# refreshes the live site. Invent a long random string and paste the same one
# in Sanity → API → Webhooks.
SANITY_REVALIDATE_SECRET=
